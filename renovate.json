{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": false,
  "customManagers": [
    {
      "currentValueTemplate": "main",
      "customType": "regex",
      "datasourceTemplate": "git-refs",
      "description": "Update ESPHome GitHub commit pins from upstream main branches",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "managerFilePatterns": [
        "/^[^/]+\\.yaml$/"
      ],
      "matchStrings": [
        "github://(?<depName>[^/\\s]+/[^/@\\s]+)(?:/[^@\\s]+)?@(?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "extends": [
    "config:recommended"
  ]
}
