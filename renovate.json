{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": false,
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "currentValueTemplate": "main",
      "customType": "regex",
      "datasourceTemplate": "git-refs",
      "description": "Update ESPHome GitHub commit pins from upstream main branches",
      "managerFilePatterns": ["/^[^/]+\\.yaml$/"],
      "matchStrings": [
        "github://(?<depName>[^/\\s]+/[^/@\\s]+)(?:/[^@\\s]+)?@(?<currentDigest>[a-f0-9]{40})"
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "python/cpython",
      "description": "Update the ESPHome-compatible Python interpreter",
      "extractVersionTemplate": "^v(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "managerFilePatterns": ["/^\\.mise\\.toml$/"],
      "matchStrings": ["uvx_args = \"--python (?<currentValue>[0-9.]+)\""],
      "versioningTemplate": "pep440"
    }
  ],
  "packageRules": [
    {
      "allowedVersions": ">=3.14,<3.15",
      "description": "Keep ESPHome on its compatible Python minor",
      "matchFileNames": [".mise.toml"],
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["python/cpython"]
    }
  ]
}
